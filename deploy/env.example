# .env next to docker-compose.yml. Keep the real file out of git.
TZ=UTC
PUID=1000
PGID=1000
APPDATA=/srv/appdata

JELLYFIN_API_KEY=
JELLYFIN_USER=
KAVITA_API_KEY=
KAVITA_USER=
ABS_API_KEY=
ABS_USER=

# bearer token for the YouTube browser extension and the iOS Shortcut (generate: openssl rand -hex 24)
BRIDGE_API_TOKEN=

# Optional: override kechimochi's addresses from config.yaml (where the bridge sends data / links in the UI)
KECHIMOCHI_URL=
KECHIMOCHI_PUBLIC_URL=
