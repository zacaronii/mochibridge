# Copy to secrets.env and fill in. secrets.env is gitignored.

# Jellyfin: Dashboard -> API Keys -> "+". Key is server-wide; JELLYFIN_USER picks whose plays count.
JELLYFIN_API_KEY=
JELLYFIN_USER=

# Kavita: User menu -> Settings -> Auth Keys (works for OIDC accounts). Sent as x-api-key.
KAVITA_API_KEY=
KAVITA_USER=

# Audiobookshelf: Settings -> API Keys, created FOR YOUR USER (not root/admin),
# so /api/me/listening-sessions returns your sessions.
ABS_API_KEY=
ABS_USER=
